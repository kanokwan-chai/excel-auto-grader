# ============================================================================
# Excel Auto Grader - Environment Configuration Template
# Copy this file to .env and fill in real credentials before running.
# ============================================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=replace-with-64-char-random-hex-secret
# Fernet key for encrypting Google OAuth tokens at rest (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=replace-with-valid-fernet-base64-key=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL / Supabase Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excel_auto_grader
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=excel-auto-grader

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Google OAuth 2.0 (Google Classroom API & Google Drive API) ---
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google-accounts/callback

# --- Excel Grading Engine ---
LIBREOFFICE_BIN=soffice
EXCEL_MAX_FILE_SIZE_MB=15
EXCEL_RECALC_TIMEOUT_SECONDS=30
LOCAL_STORAGE_DIR=./storage_data

# --- Frontend (Next.js Public Env) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
